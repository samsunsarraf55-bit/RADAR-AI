rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidPortfolioItem(data, userId) {
      return data.keys().hasAll(['userId', 'assetType', 'quantity']) &&
             data.keys().hasOnly(['userId', 'assetType', 'title', 'quantity', 'purchasePrice', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.assetType is string && data.assetType.size() <= 64 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 128)) &&
             data.quantity is number && data.quantity >= 0 && data.quantity <= 10000000 &&
             (!('purchasePrice' in data) || (data.purchasePrice is number && data.purchasePrice >= 0)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidPriceAlert(data, userId) {
      return data.keys().hasAll(['userId', 'assetCode', 'condition', 'targetPrice']) &&
             data.keys().hasOnly(['userId', 'assetCode', 'condition', 'targetPrice', 'active', 'createdAt']) &&
             data.userId == userId &&
             data.assetCode is string && data.assetCode.size() <= 64 &&
             (data.condition == 'above' || data.condition == 'below') &&
             data.targetPrice is number && data.targetPrice > 0 &&
             (!('active' in data) || data.active is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidFirmPriceTick(data) {
      return data.keys().hasAll(['firmKey', 'code', 'buy', 'sell', 'timestamp']) &&
             data.firmKey is string && data.firmKey.size() <= 64 &&
             data.code is string && data.code.size() <= 64 &&
             data.buy is number && data.buy >= 0 &&
             data.sell is number && data.sell >= 0 &&
             data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Public firm price history ticks
    match /firms/{firmKey}/priceHistory/{tickId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidFirmPriceTick(incoming());
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().email == existing().email;
      allow delete: if isOwner(userId);

      match /portfolio/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && isValidPortfolioItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(itemId) && isValidPortfolioItem(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /alerts/{alertId} {
        allow get: if isOwner(userId) && isValidId(alertId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(alertId);
      }
    }
  }
}
